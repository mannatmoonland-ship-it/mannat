# Copy to .env for local development. Replace placeholders with your own values.
# Never commit .env, Firebase Admin credentials, passwords, or private keys.
FLASK_ENV=development
SECRET_KEY=replace-with-a-unique-random-value-at-least-32-bytes
PUBLIC_BASE_URL=http://127.0.0.1:5020

FIREBASE_PROJECT_ID=replace-with-your-firebase-project-id
FIREBASE_DATABASE_URL=https://replace-with-your-project-default-rtdb.region.firebasedatabase.app
FIREBASE_WEB_CONFIG='{"apiKey":"replace-with-your-public-firebase-api-key","authDomain":"replace-with-your-project.firebaseapp.com","projectId":"replace-with-your-firebase-project-id","appId":"replace-with-your-web-app-id","messagingSenderId":"replace-with-your-messaging-sender-id"}'
# Public Web Push VAPID key from Firebase Console > Project settings > Cloud Messaging.
FIREBASE_WEB_PUSH_VAPID_KEY=

# Configure exactly one Firebase Admin credential source when connecting to Firestore.
# Keep credential files outside the repository.
# FIREBASE_SERVICE_ACCOUNT=path-to-service-account-json
# FIREBASE_SERVICE_ACCOUNT_JSON=replace-with-service-account-json
# FIREBASE_SERVICE_ACCOUNT_BASE64=replace-with-base64-encoded-service-account-json

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=replace-with-your-mail-account
MAIL_PASSWORD=replace-with-your-mail-app-password
MAIL_DEFAULT_SENDER=replace-with-your-sender-address

# Fast2SMS DLT SMS. Keep the API key private and use an approved DLT template.
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
FAST2SMS_MESSAGE_ID=

# Needed only for first-time administrator bootstrap or Camera authentication.
INITIAL_SUPER_ADMIN_PASSWORD=
CAMERA_AUTH_API_SECRET=
CAMERA_AUTH_ASSERTION_SECRET=

# Optional local Firestore credential-refresh transport override.
# FIRESTORE_GRPC_AUTH_TRANSPORT=urllib3

# Google Drive uploads for Daily Reports. Keep the OAuth client JSON outside
# the repository and public folders. Tokens are encrypted in Firestore.
# GOOGLE_OAUTH_CLIENT_SECRETS_FILE=
# Locally, the callback is derived from the request host; open the app using
# localhost and register that exact callback URI with the Google OAuth client.
# GOOGLE_OAUTH_REDIRECT_URI is ignored by the app.
# Production uses PUBLIC_BASE_URL or Render's RENDER_EXTERNAL_URL.
# Set PUBLIC_BASE_URL only when using a custom public domain on Render.
# PUBLIC_BASE_URL=https://your-domain
